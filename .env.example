# =============================================================================
#  NEXUS SCADA — environment configuration
#  Copy to `.env` and adjust for your environment.
#  Never commit the real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# When empty, the backend disables authentication (dev mode only).
# When set, mutating endpoints require a matching `X-API-Key` header.
NEXUS_API_KEY=

# -----------------------------------------------------------------------------
# Caching and agent cadence
# -----------------------------------------------------------------------------
# Seconds the equipment API cache entries stay fresh.
NEXUS_CACHE_TTL=60

# Seconds between industrial-agent ingest cycles.
NEXUS_AGENT_INTERVAL=1.0

# -----------------------------------------------------------------------------
# Modbus / PLC simulator
# -----------------------------------------------------------------------------
NEXUS_MODBUS_HOST=127.0.0.1
NEXUS_MODBUS_PORT=5020
NEXUS_MODBUS_SLAVE=1

# -----------------------------------------------------------------------------
# Remediation engine
# -----------------------------------------------------------------------------
# Path to the remediation policy document.
NEXUS_REMEDIATION_POLICY_PATH=configs/remediation_policy.json

# Set to 1 to allow direct restricted-PLC fallback (load setpoints only).
# NEXUS_REMEDIATION_DISABLE_DIRECT_PLC=0

# Set to 1 to expose the manual remediation trigger endpoint (test only).
NEXUS_ENABLE_MANUAL_REMEDIATION=0

# -----------------------------------------------------------------------------
# Local LLM
# -----------------------------------------------------------------------------
# Path to the Qwen2.5-Coder GGUF model. Must exist on disk.
# Download instructions: see README.md → Setup → Local LLM Model Download.
NEXUS_MODEL_PATH=models/qwen2.5-coder-1.5b-instruct-q6_k.gguf