# ============================================================
#  NEXUS SCADA — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- Virtual environments ----------
venv/
.venv/

# ---------- Old / unrelated project ----------
car-factory-electrical-dashboard/

# ---------- IDE ----------
.vscode/
.idea/

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Windows reserved-device-name artifacts ----------
# Any script that emits `> nul` under Git Bash will create a file
# named `nul` that Git Bash cannot delete normally. Never commit it.
nul

# ---------- Streamlit ----------
.streamlit/

# ---------- Backup / editor temp files (tripwire support) ----------
*.backup
*.bak
*.bak-*
*.py.bak

# ---------- Local backup trees (never commit history copies) ----------
docs/backups/
backups/
_heal_all_backups/
_patch_backups/
scripts/archive/autofix_backups/

# ---------- Runtime logs ----------
logs/
autofix.log
.autofix_tmp/

# ---------- Large binary artifacts (kept outside git) ----------
*.gguf
*.whl
models/*.bin
models/*.safetensors

# ---------- SQLite runtime artifacts ----------
*.db
*.db-journal
*.sqlite3
data/*.db-wal
data/*.db-shm

# ---------- Runtime audit / telemetry ----------
*.jsonl
data/agent_audit.jsonl

# ---------- Quarantined audit snapshots (local debug state) ----------
data/quarantine/

# ---------- Generated data ----------
*.csv

# ---------- Obsidian personal workspace state ----------
data/scada_vault/.obsidian/
data/scada_vault/Incidents/

# ---------- Local one-off diagnostic scripts ----------
scripts/diagnose_and_fix_warns.sh

# ---------- Runtime diagnostic bundles ----------
# Keep:    docs/evidence/latest.json
# Keep:    docs/evidence/verify-*.json
# Ignore:  every other transient diagnostic dump written during a session.
docs/evidence/warn-diagnostic-*.txt
docs/evidence/remediation-code-dump.txt
docs/evidence/sweep-after-verify-fix.txt
docs/evidence/sweep-final-A.txt
docs/evidence/sweep-final.txt
docs/evidence/latest_live_test.txt

# ---------- Tooling (uncomment if /tools/ should stay local) ----------
# /tools/

# ---------- Evidence artifacts: portfolio proof, KEEP TRACKED ----------
# (no global docs/ignore above, so nothing needs a negation rule here)