# ============================================================
#  NEXUS SCADA — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- Virtual environments ----------
venv/
.venv/

# ---------- Old / unrelated project ----------
car-factory-electrical-dashboard/

# ---------- IDE ----------
.vscode/
.idea/

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Streamlit ----------
.streamlit/

# ---------- Backup / editor temp files (tripwire support) ----------
*.backup
*.bak
*.bak-*
*.py.bak

# ---------- Local backup trees (never commit history copies) ----------
docs/backups/
backups/
_heal_all_backups/

# ---------- Runtime logs ----------
logs/

# ---------- Large binary artifacts (kept outside git) ----------
*.gguf
*.whl
models/*.bin
models/*.safetensors

# ---------- SQLite runtime artifacts ----------
*.db
*.db-journal
*.sqlite3
data/*.db-wal
data/*.db-shm

# ---------- Runtime audit / telemetry ----------
*.jsonl
data/agent_audit.jsonl

# ---------- Generated data ----------
*.csv

# ---------- Obsidian personal workspace state ----------
data/scada_vault/.obsidian/
data/scada_vault/Incidents/

# ---------- Tooling (uncomment the next line if /tools/ should stay local) ----------
# /tools/

# ---------- Evidence artifacts: portfolio proof, KEEP TRACKED ----------
!docs/evidence/*.jsonl